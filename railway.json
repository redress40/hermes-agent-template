{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  },
  "variables": {
    "ADMIN_USERNAME": {
      "description": "Dashboard login username",
      "defaultValue": "admin",
      "required": true
    },
    "ADMIN_PASSWORD": {
      "description": "Dashboard login password (min 6 chars)",
      "required": true
    },
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram bot token from @BotFather",
      "required": true
    },
    "CUSTOM_PROVIDER_API_KEY": {
      "description": "[Optional] Custom OpenAI-compatible API key (slot 1)",
      "required": false
    },
    "CUSTOM_PROVIDER_BASE_URL": {
      "description": "[Optional] Custom API base URL (slot 1)",
      "required": false
    },
    "CUSTOM_PROVIDER_NAME": {
      "description": "[Optional] Custom provider name (slot 1)",
      "defaultValue": "custom",
      "required": false
    }
  }
}